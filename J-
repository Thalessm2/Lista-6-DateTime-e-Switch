using System;

class ProgramJ
{
    static void Main()
    {
        Console.Write("Digite o tamanho da camiseta (P, M ou G): ");
        string tamanho = Console.ReadLine().ToUpper();

        switch (tamanho)
        {
            case "P":
                Console.WriteLine("Tamanho P - R$ 30,00");
                break;

            case "M":
                Console.WriteLine("Tamanho M - R$ 35,00");
                break;

            case "G":
                Console.WriteLine("Tamanho G - R$ 40,00");
                break;

            default:
                Console.WriteLine("Tamanho inválido.");
                break;
        }
    }
}
